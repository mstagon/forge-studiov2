{
  "_comment": "프리셋 합성 시 생성. 옵트인 MCP 는 New Workspace 에서 체크한 것만 mcpServers 로 승격됨.",
  "_optional_recipes": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "type": "stdio"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp",
        "--browser",
        "chrome"
      ],
      "type": "stdio"
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "figma-framelink": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "type": "stdio",
      "env": {
        "FIGMA_API_KEY": "${FIGMA_API_KEY}"
      }
    }
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "type": "stdio"
    },
    "dart": {
      "command": "dart",
      "args": [
        "mcp-server"
      ],
      "type": "stdio"
    }
  }
}