# ============================================================================
# Forge Studio — Harness Template .env sample
# ----------------------------------------------------------------------------
# 이 파일은 `.claude/mcp.json` 이 참조하는 환경 변수의 **키 목록 + placeholder** 다.
# 실제 값은 각 서비스 대시보드에서 발급받아 `.env` (gitignore 대상) 에 채워라.
#
# 사용법:
#   cp .env.example .env
#   # 필요한 MCP 서버의 키만 채우면 된다. 나머지는 placeholder 그대로 둬도 OK
#   # (키가 비어 있으면 해당 MCP는 자동으로 비활성).
#
# 주의:
#   - `.env`, `.env.dev`, `.env.stg`, `.env.prd` 전부 git 커밋 금지
#   - API 키/토큰을 코드에 하드코딩 금지
# ============================================================================


# ----------------------------------------------------------------------------
# Supabase MCP — DB 관리 / 스키마 조작 / RLS 정책
# 발급: https://supabase.com/dashboard/account/tokens
# 프로젝트 ref: Supabase 대시보드 → Project Settings → General → Reference ID
# ----------------------------------------------------------------------------
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here
SUPABASE_PROJECT_REF=your_project_ref_here


# ----------------------------------------------------------------------------
# Exa Web Search MCP — 기술 조사 / 라이브러리 비교용 웹 검색
# 발급: https://dashboard.exa.ai/api-keys
# ----------------------------------------------------------------------------
EXA_API_KEY=your_exa_api_key_here


# ----------------------------------------------------------------------------
# Firecrawl MCP — 문서 크롤링 / 경쟁사 분석
# 발급: https://www.firecrawl.dev/app/api-keys
# ----------------------------------------------------------------------------
FIRECRAWL_API_KEY=your_firecrawl_api_key_here


# ----------------------------------------------------------------------------
# Jira MCP (Atlassian) — 이슈 트래킹 / 티켓 조회/생성
# API 토큰 발급: https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_URL 예시: https://your-workspace.atlassian.net
# ----------------------------------------------------------------------------
JIRA_URL=https://your-workspace.atlassian.net
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token_here


# ----------------------------------------------------------------------------
# fal.ai MCP — 이미지/에셋 AI 생성
# 발급: https://fal.ai/dashboard/keys
# ----------------------------------------------------------------------------
FAL_KEY=your_fal_api_key_here


# ============================================================================
# 아래 MCP 서버들은 env 키가 필요 없다 (참고용)
# ----------------------------------------------------------------------------
#   - context7              : 공개 API, 키 불필요
#   - dart                  : 로컬 dart mcp-server
#   - serena                : uvx 로컬 실행
#   - sequential-thinking   : 키 불필요
#   - playwright            : 로컬 브라우저
#   - token-optimizer       : 키 불필요
#   - vercel                : HTTP MCP, OAuth 로그인 방식
#   - railway               : 로그인 기반 (`railway login`)
#   - evalview              : 로컬 파이썬 모듈
# ============================================================================
