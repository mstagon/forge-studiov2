{
  "_comment": "최소 MCP — Claude 가 자동으로 자주 호출하는 것만. 추가 필요 시 워크스페이스별 .claude/mcp.json 또는 ~/.claude.json 에 추가.",
  "_optional_recipes": {
    "dart": { "command": "dart", "args": ["mcp-server"], "type": "stdio" },
    "playwright": { "command": "npx", "args": ["-y", "@playwright/mcp", "--browser", "chrome"], "type": "stdio" },
    "serena": { "command": "uvx", "args": ["-p", "3.13", "--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server", "--context", "claude-code", "--project", ".", "--enable-web-dashboard", "False", "--enable-gui-log-window", "False"], "type": "stdio" }
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "type": "stdio"
    }
  }
}
